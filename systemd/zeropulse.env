# Zeropulse Edge Observability & Self-Healing Agent
# Konfigürasyon Dosyası: /etc/zeropulse/zeropulse.env

# Web Paneli ve API Dinleme Adresi (Varsayılan: yalnızca bu makine)
# Ağa açmadan önce TLS sunan bir reverse proxy kullanın ve ilk kurulumu tamamlayın.
ZEROPULSE_LISTEN_ADDR=127.0.0.1:8080

# Dry-Run Modu:
# true  -> Yalnızca anomalileri tespit eder ve simülasyon logu üretir
# false -> container_filter ile hedeflenen RESTART kurallarını gerçekten uygular
ZEROPULSE_DRY_RUN=true

# Anomali Eşikleri
ZEROPULSE_CPU_THRESHOLD=80.0
ZEROPULSE_MEM_THRESHOLD=85.0
ZEROPULSE_COOLDOWN=60s

# Kimlik Doğrulama (Opsiyonel)
# ZEROPULSE_AUTH_ENABLED=true
# ZEROPULSE_AUTH_USER=admin
# ZEROPULSE_AUTH_PASS=super_secure_password
# ZEROPULSE_API_TOKEN=your_secret_api_token
